# Virtual Character Companion — Environment Configuration
# Copy this to .env and fill in your API keys

# ── API Keys ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Server ────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/companion.db

# ── Default Providers ─────────────────────────────────────────────
DEFAULT_STT=WhisperAPIProvider
DEFAULT_LLM=ClaudeProvider
DEFAULT_TTS=EdgeTTSProvider

# ── LLM Settings ──────────────────────────────────────────────────
CLAUDE_MODEL=claude-haiku-4-5-20251001
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=256

# ── STT Settings ──────────────────────────────────────────────────
WHISPER_MODEL=whisper-1
WHISPER_LANGUAGE=zh

# ── TTS Settings ──────────────────────────────────────────────────
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural

# ── Memory & Mood (Phase 3) ──────────────────────────────────────
ENABLE_LONG_TERM_MEMORY=false
ENABLE_MOOD_ENGINE=false
INITIATIVE_ENABLED=false
