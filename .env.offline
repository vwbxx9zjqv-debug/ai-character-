# ── 离线模式配置 — 完全脱机运行 ──────────────────────────────────
# 使用方式: cp .env.offline .env 然后重启服务
#
# 需要的本地服务:
#   STT: faster-whisper (自动下载模型, ~150MB for base)
#   LLM: Ollama (http://localhost:11434)
#   TTS: CosyVoice 2 (http://localhost:5001) 或 GPT-SoVITS (http://localhost:9880)
#
# 安装:
#   pip install faster-whisper
#   brew install ollama && ollama pull qwen2.5:0.5b
#   # TTS: 部署 CosyVoice 2 或 GPT-SoVITS 到本地

# ── 服务器 ──────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false

# ── 数据库 ──────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/companion.db

# ── Provider 选择 ───────────────────────────────────────────────
# STT: 本地 Whisper (faster-whisper, 不联网)
DEFAULT_STT=LocalWhisperProvider
# LLM: Ollama 本地模型 (OpenAI compatible API)
DEFAULT_LLM=OpenAICompatibleProvider
# TTS: CosyVoice 2 本地服务 (你的 AI 声音模型)
DEFAULT_TTS=CosyVoice2Provider

# ── 本地 STT 配置 ───────────────────────────────────────────────
# faster-whisper 模型大小: tiny / base / small / medium / large-v3
# base 适合中文日常对话, ~150MB, CPU 实时可用
WHISPER_MODEL=base
WHISPER_LANGUAGE=zh

# ── 本地 LLM 配置 (Ollama) ─────────────────────────────────────
# Ollama 默认端口 11434, OpenAI-compatible API 在 /v1
DEEPSEEK_MODEL=qwen2.5:0.5b
DEEPSEEK_BASE_URL=http://localhost:11434/v1
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=200
# Ollama 不需要真实 API key，随便填
OPENAI_API_KEY=ollama-local

# ── 本地 TTS 配置 ───────────────────────────────────────────────
# CosyVoice 2 服务地址 (你部署的 AI 声音模型)
COSYVOICE_ENDPOINT=http://localhost:5001
# 备选: GPT-SoVITS
GPT_SOVITS_ENDPOINT=http://localhost:9880
# 备选: 自定义端点
CUSTOM_TTS_ENDPOINT=http://localhost:8001

# ── 记忆 & 情绪 (可选) ─────────────────────────────────────────
ENABLE_LONG_TERM_MEMORY=true
ENABLE_MOOD_ENGINE=true
INITIATIVE_ENABLED=true
